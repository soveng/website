---
import Base from '@/layouts/Base.astro';
import DynamicIcon from '@/helpers/DynamicIcon';
import { getBlogArticles } from '@/lib/blog';
import { blogCoverSrc, blogCoverSrcSet } from '@/lib/blogImages';
import '@/styles/blog.css';

const articles = await getBlogArticles();
const [featured, ...archive] = articles;
const date = (timestamp: number) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(timestamp * 1000);
---

<Base
  title="Blog"
  meta_title="Blog — Sovereign Engineering"
  description="Long-form writing from Sovereign Engineering, published on Nostr and readable here."
  canonical="https://sovereignengineering.io/blog"
  rssHref="/blog/rss.xml"
  showCallToAction={false}
>
  <div class="blog-page">
    <header class="blog-hero">
      <div class="container blog-container blog-hero-grid">
        <div class="blog-hero-copy">
          <p class="blog-eyebrow">Sovereign Engineering</p>
          <h1>Blog</h1>
          <p class="blog-hero-subtitle">Notes from the frontier of freedom tech.</p>
          <div class="mt-6 flex flex-wrap gap-4">
            <a class="btn-retro" href="/blog/rss.xml" type="application/rss+xml">
              <DynamicIcon icon="FaRss" className="inline-block w-4 h-4 mr-2 align-text-bottom" />
              RSS
            </a>
            <a
              href="https://njump.to/sovereignengineering.io"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-retro"
            >
              <DynamicIcon icon="FaFeather" className="inline-block w-4 h-4" />
              <span class="sr-only">Nostr Profile</span>
            </a>
          </div>
        </div>
        <div class="blog-hero-visual">
          <img
            src="/images/shining-city-in-cyberspace.webp"
            alt="A figure looking toward a glowing city"
            width="640"
            height="576"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <section class="container blog-container blog-index" aria-label="Articles">
      {featured && (
        <article>
          <a href={`/blog/${featured.slug}`} class="blog-feature" aria-label={`Read ${featured.title}`}>
            {featured.image && (
              <span class="blog-feature-image">
                <img
                  src={blogCoverSrc(featured.image, 960)}
                  srcset={blogCoverSrcSet(featured.image, [960, 1600])}
                  sizes="(max-width: 700px) 100vw, (max-width: 1120px) 47vw, 530px"
                  alt=""
                  width="960"
                  height="720"
                  loading="eager"
                  decoding="async"
                />
              </span>
            )}
            <div class="blog-feature-copy">
              <p class="blog-item-meta"><time datetime={new Date(featured.publishedAt * 1000).toISOString()}>{date(featured.publishedAt)}</time></p>
              <h2>{featured.title}</h2>
              {featured.summary && <p class="blog-summary">{featured.summary}</p>}
              <span class="btn btn-primary mt-6">Read article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </article>
      )}

      <ol class="blog-list">
        {archive.map((article) => (
          <li>
            <article>
              <a href={`/blog/${article.slug}`} class="blog-list-item" aria-label={`Read ${article.title}`}>
                <div class="blog-list-copy">
                  <p class="blog-item-meta"><time datetime={new Date(article.publishedAt * 1000).toISOString()}>{date(article.publishedAt)}</time></p>
                  <h2>{article.title}</h2>
                  {article.summary && <p class="blog-summary">{article.summary}</p>}
                </div>
                {article.image && (
                  <span class="blog-list-image">
                    <img src={blogCoverSrc(article.image, 320)} alt="" width="320" height="224" loading="lazy" decoding="async" />
                  </span>
                )}
              </a>
            </article>
          </li>
        ))}
      </ol>
      {!featured && <p>No articles available yet. <a href="https://njump.me/sovereignengineering.io">Read us on Nostr.</a></p>}
      {featured && (
        <>
          <figure class="blog-endmark" aria-hidden="true">
            <img src="/images/contest/separator-ship.png" alt="" width="2172" height="724" loading="lazy" decoding="async" />
          </figure>
          <div class="blog-podcast-cta">
            <p class="blog-eyebrow">No Solutions</p>
            <h2>Only Trade-Offs</h2>
            <p>
              We talk, we walk, we ship on Fridays. No Solutions is the podcast where we keep arguing about the same work:
              builders, protocols, and the trade-offs behind it.
            </p>
            <a href="/podcast" class="btn-retro">Listen to No Solutions</a>
          </div>
        </>
      )}
    </section>
  </div>
</Base>

<script>
  import { startBlogCityFlicker, stopBlogCityFlicker } from '@/scripts/blogCityFlicker';

  document.addEventListener('astro:page-load', startBlogCityFlicker);
  document.addEventListener('astro:before-swap', stopBlogCityFlicker);
</script>
