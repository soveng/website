---
import Base from '@/layouts/Base.astro';
import { getBlogArticles } from '@/lib/blog';
import { blogCoverSrc, blogCoverSrcSet } from '@/lib/blogImages';
import '@/styles/blog.css';

const articles = await getBlogArticles();
const [featured, ...archive] = articles;
const date = (timestamp: number) => new Intl.DateTimeFormat('en', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
}).format(timestamp * 1000);
---

<Base
  title="Dispatches"
  meta_title="Dispatches — Sovereign Engineering"
  description="Long-form writing from Sovereign Engineering, published on Nostr and readable here."
  canonical="https://sovereignengineering.io/blog"
  rssHref="/blog/rss.xml"
  showCallToAction={false}
>
  <div class="blog-page">
    <header class="blog-hero">
      <div class="container blog-container blog-hero-grid">
        <div class="blog-hero-copy">
          <p class="blog-eyebrow">The Sovereign Engineering Blog</p>
          <h1>Dispatches</h1>
          <p class="blog-hero-subtitle">Notes from the frontier of freedom tech.</p>
          <a class="blog-rss-link" href="/blog/rss.xml" type="application/rss+xml">RSS <i class="fa-solid fa-rss" aria-hidden="true"></i></a>
        </div>
        <div class="blog-hero-visual">
          <img
            src="/images/shining-city-in-cyberspace.webp"
            alt="A figure looking toward a glowing city"
            width="640"
            height="576"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    <section class="container blog-container blog-index" aria-label="Articles">
      {featured && (
        <article class="blog-feature">
          {featured.image && (
            <a href={`/blog/${featured.slug}`} class="blog-feature-image" aria-label={`Read ${featured.title}`}>
              <img
                src={blogCoverSrc(featured.image, 960)}
                srcset={blogCoverSrcSet(featured.image, [960, 1600])}
                sizes="(max-width: 700px) 100vw, (max-width: 1120px) 47vw, 530px"
                alt=""
                width="960"
                height="720"
                loading="eager"
                decoding="async"
              />
            </a>
          )}
          <div class="blog-feature-copy">
            <p class="blog-item-meta"><time datetime={new Date(featured.publishedAt * 1000).toISOString()}>{date(featured.publishedAt)}</time><span>Latest article</span></p>
            <h2><a href={`/blog/${featured.slug}`}>{featured.title}</a></h2>
            {featured.summary && <p class="blog-summary">{featured.summary}</p>}
            <a href={`/blog/${featured.slug}`} class="blog-read-link">Read article <span aria-hidden="true">→</span></a>
          </div>
        </article>
      )}

      <div class="blog-list-heading">
        <h2>other articles</h2>
        <span>{archive.length} articles</span>
      </div>
      <ol class="blog-list">
        {archive.map((article) => (
          <li>
            <article class="blog-list-item">
              <div class="blog-list-copy">
                <p class="blog-item-meta"><time datetime={new Date(article.publishedAt * 1000).toISOString()}>{date(article.publishedAt)}</time></p>
                <h3><a href={`/blog/${article.slug}`}>{article.title}</a></h3>
                {article.summary && <p class="blog-summary">{article.summary}</p>}
              </div>
              {article.image && (
                <a href={`/blog/${article.slug}`} class="blog-list-image" aria-label={`Read ${article.title}`}>
                  <img src={blogCoverSrc(article.image, 320)} alt="" width="320" height="224" loading="lazy" decoding="async" />
                </a>
              )}
            </article>
          </li>
        ))}
      </ol>
      {!featured && <p>No articles available yet. <a href="https://njump.me/sovereignengineering.io">Read us on Nostr.</a></p>}
    </section>
  </div>
</Base>

<script>
  import { startBlogCityFlicker, stopBlogCityFlicker } from '@/scripts/blogCityFlicker';

  document.addEventListener('astro:page-load', startBlogCityFlicker);
  document.addEventListener('astro:before-swap', stopBlogCityFlicker);
</script>
